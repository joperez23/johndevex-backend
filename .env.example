SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/finance_db
REQUEST_TIMEOUT_SECS=15
RUST_LOG=info

# WhatsApp Worker (headless_chrome)
# Path to the Chrome/Chromium binary. Auto-detected if not set.
# Example: CHROME_PATH=/usr/bin/chromium-browser
CHROME_PATH=

# Set to "true" to run Chrome in headless mode (after the QR code has been scanned once)
WHATSAPP_HEADLESS=false
GMAIL_USER=correo
GMAIL_PASSWORD=pass
