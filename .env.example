# ============================================================================
# Copia este archivo a ".env" y ajusta los valores para tu entorno.
# ============================================================================

# ------------------------------ Servidor -----------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Número de workers HTTP (opcional). Por defecto = núm. de CPUs lógicos.
# SERVER_WORKERS=4

# ---------------------------- Base de datos ---------------------------------
# Cadena de conexión de PostgreSQL. Es la única variable obligatoria.
DATABASE_URL=postgres://bcv:bcv@localhost:5432/bcv_rates
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECT_TIMEOUT_SECS=10

# ------------------------------ Scraper BCV ---------------------------------
BCV_URL=https://www.bcv.org.ve/glosario/cambio-oficial
BCV_REQUEST_TIMEOUT_SECS=20

# El sitio del BCV suele presentar problemas/errores con su certificado TLS.
# Por eso, por defecto, se desactiva la verificación estricta del certificado
# ÚNICAMENTE para esta URL fija y conocida (no se usa para nada más).
# Cambia a "false" si en tu entorno el certificado del BCV es válido.
BCV_INSECURE_TLS=true

# Si defines esta variable, se ejecuta un scraping automático cada N segundos
# (ej: 3600 = cada hora). Si la dejas comentada, el scraping solo ocurre
# cuando se invoca el endpoint POST /api/v1/exchange-rates/scrape.
# BCV_SCRAPE_INTERVAL_SECS=3600

# --------------------------------- CORS -------------------------------------
# Lista de orígenes permitidos separados por coma, o "*" para permitir todos.
CORS_ALLOWED_ORIGINS=*

# ------------------------------- Logging ------------------------------------
RUST_LOG=info,ntex=info,sqlx=warn
